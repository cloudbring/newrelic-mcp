# New Relic MCP Server Configuration
# Copy this file to .env and add your credentials

# Authenticate with EITHER a User API Key OR a system identity (see below)
# Your New Relic User API Key
# Get it from: https://one.newrelic.com/api-keys
NEW_RELIC_API_KEY=NRAK-XXXXXXXXXXXXXXXXXXXXXXXXXX

# System identity (alternative to the API key; preferred for cloud agents)
# NEW_RELIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# NEW_RELIC_PRIVATE_KEY_PATH=/path/to/private-key.pem
# NEW_RELIC_PRIVATE_KEY=  # PEM contents instead of a path
# In system identity mode, NEW_RELIC_API_KEY is only used for REST v2 tools

# Optional: Your New Relic Account ID  
# Find it in the URL when logged into New Relic or in Administration > Access management
# Can also be provided per tool call if not set here
NEW_RELIC_ACCOUNT_ID=1234567

# Optional: License key for APM instrumentation (if you want to monitor this MCP server)
# NEW_RELIC_LICENSE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxFFFFNRAL

# Optional: Enable OpenTelemetry for test telemetry
# OTEL_ENABLED=false
# NEW_RELIC_ENABLED=false